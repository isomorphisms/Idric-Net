module Network.HTTP

import Network.Types
import Network.URL

%default total

public export
choice http_method one_of
  get_method
  post_method
  head_method
  put_method
  delete_method
  options_method
  trace_method
  connect_method
  patch_method
  extension_method String

public export
method_text : http_method → String
method_text get_method = "GET"
method_text post_method = "POST"
method_text head_method = "HEAD"
method_text put_method = "PUT"
method_text delete_method = "DELETE"
method_text options_method = "OPTIONS"
method_text trace_method = "TRACE"
method_text connect_method = "CONNECT"
method_text patch_method = "PATCH"
method_text (extension_method text) = text

public export
method_is_safe : http_method → Bool
method_is_safe get_method = True
method_is_safe head_method = True
method_is_safe options_method = True
method_is_safe trace_method = True
method_is_safe _ = False

public export
method_is_idempotent : http_method → Bool
method_is_idempotent get_method = True
method_is_idempotent head_method = True
method_is_idempotent put_method = True
method_is_idempotent delete_method = True
method_is_idempotent options_method = True
method_is_idempotent trace_method = True
method_is_idempotent _ = False

export
record HTTPStatusCode where
  constructor MkHTTPStatusCode
  http_status_bits : Bits16

public export
http_status_code_from_number : ℕ → Either String HTTPStatusCode
http_status_code_from_number number =
  if number >= 100 && number <= 599
    then Right (MkHTTPStatusCode (cast number))
    else Left "HTTP status code must be between 100 and 599"

public export
http_status_number : HTTPStatusCode → Bits16
http_status_number (MkHTTPStatusCode number) = number

public export
choice http_status_class one_of
  informational
  successful
  redirection
  client_error
  server_error

public export
http_status_class_of : HTTPStatusCode → http_status_class
http_status_class_of status =
  let number = http_status_number status in
    if number < 200
      then informational
      else if number < 300
        then successful
        else if number < 400
          then redirection
          else if number < 500
            then client_error
            else server_error

public export
continue_status : HTTPStatusCode
continue_status = MkHTTPStatusCode 100

public export
ok : HTTPStatusCode
ok = MkHTTPStatusCode 200

public export
created : HTTPStatusCode
created = MkHTTPStatusCode 201

public export
no_content : HTTPStatusCode
no_content = MkHTTPStatusCode 204

public export
moved_permanently : HTTPStatusCode
moved_permanently = MkHTTPStatusCode 301

public export
found : HTTPStatusCode
found = MkHTTPStatusCode 302

public export
see_other : HTTPStatusCode
see_other = MkHTTPStatusCode 303

public export
temporary_redirect : HTTPStatusCode
temporary_redirect = MkHTTPStatusCode 307

public export
permanent_redirect : HTTPStatusCode
permanent_redirect = MkHTTPStatusCode 308

public export
bad_request : HTTPStatusCode
bad_request = MkHTTPStatusCode 400

public export
unauthorized : HTTPStatusCode
unauthorized = MkHTTPStatusCode 401

public export
forbidden : HTTPStatusCode
forbidden = MkHTTPStatusCode 403

public export
not_found : HTTPStatusCode
not_found = MkHTTPStatusCode 404

public export
method_not_allowed : HTTPStatusCode
method_not_allowed = MkHTTPStatusCode 405

public export
gone : HTTPStatusCode
gone = MkHTTPStatusCode 410

public export
too_many_requests : HTTPStatusCode
too_many_requests = MkHTTPStatusCode 429

public export
internal_server_error : HTTPStatusCode
internal_server_error = MkHTTPStatusCode 500

public export
bad_gateway : HTTPStatusCode
bad_gateway = MkHTTPStatusCode 502

public export
service_unavailable : HTTPStatusCode
service_unavailable = MkHTTPStatusCode 503

public export
gateway_timeout : HTTPStatusCode
gateway_timeout = MkHTTPStatusCode 504

public export
is_redirect_status : HTTPStatusCode → Bool
is_redirect_status status =
  let number = http_status_number status in
    number == 301 || number == 302 || number == 303 ||
    number == 307 || number == 308

public export
record HeaderName where
  constructor MkHeaderName
  header_name_text : String

public export
record HeaderValue where
  constructor MkHeaderValue
  header_value_text : String

public export
record HttpHeader where
  constructor MkHttpHeader
  header_name : HeaderName
  header_value : HeaderValue

ascii_lower : Char → Char
ascii_lower character =
  if character >= 'A' && character <= 'Z'
    then chr (ord character + 32)
    else character

ascii_equal : List Char → List Char → Bool
ascii_equal [] [] = True
ascii_equal [] _ = False
ascii_equal _ [] = False
ascii_equal (left :: remaining_left) (right :: remaining_right) =
  ascii_lower left == ascii_lower right &&
  ascii_equal remaining_left remaining_right

header_named : String → HeaderName → Bool
header_named wanted actual =
  ascii_equal (unpack wanted) (unpack (header_name_text actual))

public export
choice http_header_kind one_of
  ordinary_header
  credential_header
  framing_header

public export
classify_header : HeaderName → http_header_kind
classify_header name =
  if header_named "Authorization" name || header_named "Cookie" name
    then credential_header
    else if header_named "Connection" name ||
            header_named "Content-Length" name ||
            header_named "Transfer-Encoding" name
      then framing_header
      else ordinary_header

public export
header : String → String → HttpHeader
header name value = MkHttpHeader (MkHeaderName name) (MkHeaderValue value)

public export
choice request_header one_of
  ordinary_request_header HttpHeader
  declared_credential_header HttpHeader

request_header_value : request_header → HttpHeader
request_header_value (ordinary_request_header value) = value
request_header_value (declared_credential_header value) = value

request_header_name : request_header → HeaderName
request_header_name value = header_name (request_header_value value)

header_name_character : Char → Bool
header_name_character character =
  (character >= 'A' && character <= 'Z') ||
  (character >= 'a' && character <= 'z') ||
  (character >= '0' && character <= '9') ||
  character == '-' || character == '_'

header_value_character : Char → Bool
header_value_character character =
  character == '\t' || (ord character >= 32 && ord character < 127)

all_characters : (Char → Bool) → List Char → Bool
all_characters predicate [] = True
all_characters predicate (character :: rest) =
  predicate character && all_characters predicate rest

header_problem : HttpHeader → Maybe String
header_problem current =
  let name = header_name_text (header_name current)
      value = header_value_text (header_value current)
  in if name == ""
    then Just "HTTP header name is empty"
    else if not (all_characters header_name_character (unpack name))
      then Just "HTTP header name must contain only ASCII letters, digits, '-' or '_'"
      else if not (all_characters header_value_character (unpack value))
        then Just "HTTP header value must be ASCII without control characters"
        else case classify_header (header_name current) of
          framing_header => Just ("Idric-Net owns HTTP framing header: " ++ name)
          _ => Nothing

public export
make_header : String → String → Either String request_header
make_header name value =
  let built = header name value in
    case header_problem built of
      Nothing => Right (ordinary_request_header built)
      Just problem => Left problem

public export
make_credential_header : String → String → Either String request_header
make_credential_header name value =
  let built = header name value in
    case header_problem built of
      Nothing => Right (declared_credential_header built)
      Just problem => Left problem

public export
credential_header_names : List request_header → List HeaderName
credential_header_names [] = []
credential_header_names (ordinary_request_header _ :: rest) =
  credential_header_names rest
credential_header_names (declared_credential_header current :: rest) =
  header_name current :: credential_header_names rest

request_header_named : String → request_header → Bool
request_header_named wanted current =
  header_named wanted (request_header_name current)

has_request_header : String → List request_header → Bool
has_request_header _ [] = False
has_request_header wanted (current :: rest) =
  request_header_named wanted current || has_request_header wanted rest

validate_request_headers : List request_header → Maybe String
validate_request_headers [] = Nothing
validate_request_headers (current :: rest) =
  case header_problem (request_header_value current) of
    Just problem => Just problem
    Nothing => validate_request_headers rest

optional_default_header :
  String → String → List request_header → String
optional_default_header name value headers =
  if has_request_header name headers
    then ""
    else name ++ ": " ++ value ++ "\r\n"

request_headers_before_body : url → List request_header → String
request_headers_before_body target_url headers =
  optional_default_header "Host" (authority target_url) headers ++
  "Connection: close\r\n" ++
  optional_default_header "Accept-Encoding" "identity" headers ++
  optional_default_header "User-Agent" "idric-net/0.1" headers

render_header : HttpHeader → String
render_header (MkHttpHeader name value) =
  header_name_text name ++ ": " ++ header_value_text value ++ "\r\n"

render_headers : List HttpHeader → String
render_headers [] = ""
render_headers (current :: rest) = render_header current ++ render_headers rest

public export
render_request_header : request_header → String
render_request_header value = render_header (request_header_value value)

render_request_headers : List request_header → String
render_request_headers [] = ""
render_request_headers (current :: rest) =
  render_request_header current ++ render_request_headers rest

common_headers : url → List HttpHeader
common_headers target_url =
  header "Host" (authority target_url) ::
  header "Connection" "close" ::
  header "Accept-Encoding" "identity" ::
  header "User-Agent" "idric-net/0.1" ::
  []

public export
choice request one_of
  get url
  post url HttpBody

public export
request_url : request → url
request_url (get target_url) = target_url
request_url (post target_url _) = target_url

public export
record HttpRequestHead where
  constructor MkHttpRequestHead
  request_head_text : String

public export
http_request_head_text : HttpRequestHead → String
http_request_head_text (MkHttpRequestHead text) = text

public export
record RenderedRequest where
  constructor MkRenderedRequest
  request_head : HttpRequestHead
  request_body : HttpBody
  request_body_length : ByteCount

public export
rendered_request_head : RenderedRequest → HttpRequestHead
rendered_request_head (MkRenderedRequest wire_head _ _) = wire_head

public export
rendered_request_body : RenderedRequest → HttpBody
rendered_request_body (MkRenderedRequest _ body _) = body

public export
rendered_request_body_length : RenderedRequest → ByteCount
rendered_request_body_length (MkRenderedRequest _ _ body_length) = body_length

request_line : http_method → url → String
request_line method target_url =
  method_text method ++ " " ++
  request_target_text (target target_url) ++
  " HTTP/1.0\r\n"

public export
render_request_parts : request → RenderedRequest
render_request_parts (get target_url) =
  let wire_head =
        request_line get_method target_url ++
        render_headers (common_headers target_url) ++
        "\r\n"
  in MkRenderedRequest
       (MkHttpRequestHead wire_head)
       (MkHttpBody "")
       (MkByteCount 0)
render_request_parts (post target_url body) =
  let body_length = utf8_byte_length (http_body_text body)
      post_headers =
        common_headers target_url ++
        (header "Content-Type" "text/plain; charset=utf-8" ::
         header "Content-Length" (show (byte_count_value body_length)) ::
         [])
      wire_head =
        request_line post_method target_url ++
        render_headers post_headers ++
        "\r\n"
  in MkRenderedRequest (MkHttpRequestHead wire_head) body body_length

public export
render_request_parts_with_headers :
  request → List request_header → Either String RenderedRequest
render_request_parts_with_headers value headers =
  case validate_request_headers headers of
    Just problem => Left problem
    Nothing =>
      case value of
        get target_url =>
          let wire_head =
                request_line get_method target_url ++
                request_headers_before_body target_url headers ++
                render_request_headers headers ++
                "\r\n"
          in Right
               (MkRenderedRequest
                 (MkHttpRequestHead wire_head)
                 (MkHttpBody "")
                 (MkByteCount 0))
        post target_url body =>
          let body_length = utf8_byte_length (http_body_text body)
              wire_head =
                request_line post_method target_url ++
                request_headers_before_body target_url headers ++
                optional_default_header
                  "Content-Type" "text/plain; charset=utf-8" headers ++
                render_request_headers headers ++
                "Content-Length: " ++ show (byte_count_value body_length) ++ "\r\n" ++
                "\r\n"
          in Right
               (MkRenderedRequest
                 (MkHttpRequestHead wire_head)
                 body
                 body_length)

public export
render_request_with_headers :
  request → List request_header → Either String String
render_request_with_headers value headers =
  case render_request_parts_with_headers value headers of
    Left problem => Left problem
    Right (MkRenderedRequest wire_head body _) =>
      Right (http_request_head_text wire_head ++ http_body_text body)

public export
render_request : request → String
render_request value =
  case render_request_parts value of
    MkRenderedRequest wire_head body _ =>
      http_request_head_text wire_head ++ http_body_text body
